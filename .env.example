# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=face_attendance_db
COMPANY_ID=your_company_id

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCATION=:memory:
QDRANT_COLLECTION=face_attendance

# Camera Configuration (Có thể cấu hình trong app)
CAMERA_IP=192.168.1.100
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASS=password
CAMERA_NAME=Main Camera
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Recognition Settings
RECOGNITION_THRESHOLD=0.4
EMBEDDING_DIM=512
DETECTION_COOLDOWN=900
MAX_FACES=100
CAPTURE_MAX_WIDTH=640

# InsightFace Model
INSIGHTFACE_MODEL=buffalo_s
INSIGHTFACE_DET_SIZE=640,640
INSIGHTFACE_DET_THRESH=0.5

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
BASE_URL=http://127.0.0.1:8000

# Webhook Configuration
USER_WEBHOOK_URL=https://your-webhook-url.com/api/webhooks/user

# Authentication Service (HKB)
AUTH_SERVICE_URL=https://auth.bittechx.cloud
GROUP_AUTH_KEY=your_group_auth_key
SYSTEM_ID=attendance_system
SYSTEM_REGISTER=

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
ENABLE_CONSOLE_LOG=true

# Test Mode (Bỏ qua cooldown khi test)
TEST_MODE=false
